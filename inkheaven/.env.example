# Server-side environment. Read by scripts/bookingProxy.mjs only.
# These are NOT prefixed with VITE_ on purpose — that prefix is what Vite
# inlines into the client bundle, which would leak the webhook URL to visitors.
# Copy this file to `.env` (gitignored) and fill in real values.

# Destination n8n "Receive Webhook" URL. Required in production.
BOOKING_WEBHOOK_URL=https://webhook.example.com/inkheaven-booking

# Set to "1" only for local development. Lets the settings panel supply the URL
# via the x-webhook-url header instead of the server environment. Leave unset in
# production: it makes /api/bookings an open relay to any public host.
# ALLOW_CLIENT_WEBHOOK_OVERRIDE=1

# Set to "1" when running behind a reverse proxy so rate limiting reads the real
# client IP from X-Forwarded-For. Leave unset when exposed directly.
# TRUST_PROXY=1

# Submission throttling. Defaults: 5 requests per 10 minutes per IP.
# BOOKING_RATE_LIMIT=5
# BOOKING_RATE_WINDOW_MS=600000