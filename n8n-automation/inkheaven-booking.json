{
  "name": "Inkheaven - Booking Requests",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inkheaven-booking",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Booking Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 300],
      "webhookId": "inkheaven-booking"
    },
    {
      "parameters": {
        "jsCode": "// Guarded the same way the site guards it: the proxy already\n// strips control characters and enforces the honeypot, but a workflow can\n// also be triggered directly, so re-check here before writing anywhere.\nconst body = $input.first().json.body ?? $json;\n\nif (body.company) {\n  // Honeypot tripped. Acknowledge and drop it silently.\n  return [];\n}\n\nconst required = ['name', 'email', 'phone', 'description'];\nconst missing = required.filter((key) => !body[key]);\n\nif (missing.length) {\n  throw new Error(`Missing required field(s): ${missing.join(', ')}`);\n}\n\nreturn [{\n  json: {\n    name: body.name,\n    email: body.email,\n    phone: body.phone,\n    style: body.style || 'Not specified',\n    placement: body.placement || 'Not specified',\n    size: body.size || 'Not specified',\n    description: body.description,\n    date: body.date || null,\n    dateIso: body.dateIso || null,\n    time: body.time || null,\n    budget: body.budget || null,\n    page: body.page || null,\n    submittedAt: body.submittedAt || $now.toISO(),\n  },\n}];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validate Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 300]
    },
    {
      "parameters": {
        "amount": 100,
        "unit": "minutes"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Dedupe Window",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [80, 300],
      "webhookId": "a1b2c3d4-0003-4000-8000-000000000003"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dedupe-email",
              "leftValue": "={{ $json.email }}",
              "rightValue": "={{ $('Booking Webhook').item.json.body.email }}",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Is New Enquiry",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "high-value",
              "leftValue": "={{ $json.budget }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Has Budget",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [540, 180]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    subject: `[Inkheaven] New booking enquiry — ${$json.name}`,\n    ...$json,\n    priority: 'high',\n  },\n}];"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "High Value Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 100]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    subject: `[Inkheaven] New booking enquiry — ${$json.name}`,\n    ...$json,\n    priority: 'normal',\n  },\n}];"
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Standard Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 280]
    },
    {
      "parameters": {
        "to": "={{ $env.INKHEAVEN_NOTIFICATION_EMAIL }}",
        "from": "={{ $env.INKHEAVEN_SMTP_FROM }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "=Name: {{ $json.name }}\nEmail: {{ $json.email }}\nPhone: {{ $json.phone }}\n\nStyle: {{ $json.style }}\nPlacement: {{ $json.placement }}\nSize: {{ $json.size }}\nBudget: {{ $json.budget }}\nPreferred date: {{ $json.date }} {{ $json.time }}\n\n{{ $json.description }}\n\nReceived: {{ $json.submittedAt }}",
        "options": {}
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Email Studio",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1300, 300]
    }
  ],
  "connections": {
    "Booking Webhook": {
      "main": [[{ "node": "Validate Booking", "type": "main", "index": 0 }]]
    },
    "Validate Booking": {
      "main": [[{ "node": "Dedupe Window", "type": "main", "index": 0 }]]
    },
    "Dedupe Window": {
      "main": [[{ "node": "Is New Enquiry", "type": "main", "index": 0 }]]
    },
    "Is New Enquiry": {
      "main": [
        [{ "node": "Has Budget", "type": "main", "index": 0 }],
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    },
    "Has Budget": {
      "main": [
        [{ "node": "High Value Payload", "type": "main", "index": 0 }],
        [{ "node": "Standard Payload", "type": "main", "index": 0 }]
      ]
    },
    "High Value Payload": {
      "main": [[{ "node": "Email Studio", "type": "main", "index": 0 }]]
    },
    "Standard Payload": {
      "main": [[{ "node": "Email Studio", "type": "main", "index": 0 }]]
    },
    "Email Studio": {
      "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "active": false,
  "versionId": "0f0a1b2c-3d4e-5f60-7a8b-9c0d1e2f3a4b",
